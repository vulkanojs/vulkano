{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_linter/src/config/schema.json",
  "env": {
    "node": true,
    "browser": true,
    "es6": true
  },
  "globals": {
    "app": "readonly",
    "io": "readonly",
    "ApiClient": "readonly",
    "Crontab": "readonly",
    "Encrypter": "readonly",
    "Filter": "readonly",
    "i18n": "readonly",
    "Merge": "readonly",
    "Paginate": "readonly",
    "VSError": "readonly",
    "ABS_PATH": "readonly",
    "APP_PATH": "readonly",
    "CORE_PATH": "readonly",
    "PUBLIC_PATH": "readonly"
  },
  "rules": {
    "curly": "error",
    "no-console": "off",
    "no-underscore-dangle": "off",
    "no-throw-literal": "off",
    "no-unneeded-ternary": "off",
    "guard-for-in": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": ["node_modules", "public", "test", "bundle", "tasks", "docs", "clean"]
}

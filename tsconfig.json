{
  // Type-checks the JS sources (checkJs) for `vp check`/`vp lint` (typeCheck in
  // oxlint.config.mts) and the editor. Not a TS migration: no emit; strict minus
  // noImplicitAny (untyped JS params stay any — add JSDoc where types help).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["app/**/*.js", "frontend/**/*.js", "scripts/**/*.js", "types/**/*.d.ts"]
}

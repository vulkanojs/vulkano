{
  "name": "vulkano",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "app.js",
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently -n VITE,APP -c green,magenta 'vp dev' './node_modules/nodemon/bin/nodemon.js --inspect'",

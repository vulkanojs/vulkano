    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "nodemon": "^3.1.14",
    "sass": "^1.101.6",
    "sharp": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
